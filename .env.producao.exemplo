# Copie para .env.producao (que NÃO vai para o git) e preencha. Depois:
#   node scripts/vercel-env.mjs
# ---------------------------------------------------------------------------

# Supabase > seu projeto > botão "Connect" > aba "ORMs" ou "Connection string".
# Troque [YOUR-PASSWORD] pela senha do banco (definida ao criar o projeto).
#
# Transaction pooler (porta 6543): usado pela aplicação na Vercel.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:6543/postgres
# Session pooler (porta 5432): usado só para aplicar as migrações no build.
DIRECT_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres

# IA gratuita (recomendado). Chave em https://console.groq.com/keys
GROQ_API_KEY=
# Opcional. Chave em https://aistudio.google.com/apikey
# (plano gratuito: usada só em tarefas sem dados pessoais, como ler vagas)
GEMINI_API_KEY=

# Opcional: domínio próprio (o padrão é o domínio de produção da Vercel).
# APP_ORIGIN=https://decifra.com.br
