# ============================================================
# DECIFRA — variáveis de ambiente (copie para .env e ajuste)
# Nunca coloque credenciais reais neste arquivo.
# ============================================================

# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# Origem pública do frontend. Usada para validar a origem das requisições (CSRF).
# Em desenvolvimento é o Vite; em produção, a URL do app (ex.: https://decifra.app).
APP_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
# Fuso das datas do produto: prazos, "hoje" e a virada das cotas diárias e mensais (nome IANA)
APP_TZ=America/Sao_Paulo
# true quando o app roda atrás de HTTPS. Em produção o padrão já é true.
# COOKIE_SECURE=true
# Número de proxies reversos confiáveis na frente da API (Nginx, Render, Railway...). 0 = nenhum.
# Use o número exato: confiar na cadeia inteira de X-Forwarded-For permite burlar o rate limit.
TRUST_PROXY=0
# Em produção, a API serve o build do frontend a partir desta pasta.
# WEB_DIST=../web/dist

# --- Banco de dados ---
# SQLite local (caminho relativo a apps/api/prisma). Para PostgreSQL, veja docs/DATA_MODEL.md.
DATABASE_URL=file:./dev.db

# =====================================================================
# Inteligência Artificial
# ---------------------------------------------------------------------
# Sem nenhuma chave abaixo, o DECIFRA funciona com o motor de regras
# (Raio-X, Tradutor, histórias e feedback). O Mentor e a importação de
# currículo ficam indisponíveis, com aviso na tela.
#
# Cada provedor é habilitado ao preencher a chave (ou o modelo, no Ollama).
# O roteador escolhe o provedor por tarefa e complexidade, tenta o próximo
# em caso de falha/limite e respeita a política de privacidade.
# Guia completo: docs/IA.md
# =====================================================================

# --- Provedores gratuitos ---
# Groq (gratuito; não treina com os dados). Chave: https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL_SIMPLES=openai/gpt-oss-20b
# GROQ_MODEL_INTERMEDIARIA=openai/gpt-oss-120b
# GROQ_MODEL_COMPLEXA=openai/gpt-oss-120b

# Google Gemini (plano gratuito: o Google pode usar os dados para melhorar produtos).
# Chave: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gratuito | pago (projeto com faturamento: o Google não usa os dados para treino)
GEMINI_PLANO=gratuito
# GEMINI_MODEL_SIMPLES=gemini-3.5-flash-lite
# GEMINI_MODEL_INTERMEDIARIA=gemini-3.8-flash
# GEMINI_MODEL_COMPLEXA=gemini-4-hydrogen

# OpenRouter (modelos ":free" de vários fornecedores). Chave: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Obrigatório com a chave: escolha um modelo terminado em ":free" em https://openrouter.ai/models
OPENROUTER_MODEL=
# true = só provedores que não coletam dados (data_collection: deny); pode reduzir os modelos disponíveis
OPENROUTER_SEM_COLETA=false

# Ollama (local, sem custo e sem enviar dados para fora). Instale em https://ollama.com e rode: ollama pull qwen2.5:7b-instruct
OLLAMA_MODEL=
# OLLAMA_MODEL_SIMPLES=qwen2.5:3b-instruct
# OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Provedores pagos (opcionais, com sua própria chave) ---
ANTHROPIC_API_KEY=
# default = fallback automático do servidor quando o modelo recusa; off = desativado
ANTHROPIC_FALLBACKS=default
OPENAI_API_KEY=

# Servidor próprio compatível com a API da OpenAI (vLLM, LM Studio...)
# COMPAT_BASE_URL=http://localhost:8000/v1
# COMPAT_MODEL=
# COMPAT_API_KEY=
# local | sem_treino | pode_treinar
# COMPAT_PRIVACIDADE=local

# --- Roteamento ---
# Ordem padrão: gratuito principal > secundário > demais gratuitos > pagos.
# Nas tarefas complexas, o provedor avançado (se definido) vem primeiro.
AI_GRATUITO_PRINCIPAL=groq
AI_GRATUITO_SECUNDARIO=gemini
# none | anthropic | openai | gemini | groq | openrouter | ollama
AI_AVANCADO=none
# Rotas explícitas por nível (substituem a ordem padrão). Aceitam "provedor" ou "provedor:modelo".
# AI_ROTA_SIMPLES=groq,gemini
# AI_ROTA_INTERMEDIARIA=gemini,groq
# AI_ROTA_COMPLEXA=anthropic,gemini:gemini-4-hydrogen
# Rotas por tarefa: AI_ROTA_MENTOR, AI_ROTA_EXTRAIR_REQUISITOS, AI_ROTA_TRADUZIR,
# AI_ROTA_HISTORIA, AI_ROTA_FEEDBACK, AI_ROTA_IMPORTAR_CV
# AI_ROTA_IMPORTAR_CV=ollama
# Desliga provedores mesmo com chave (ex.: para testes)
# AI_DESATIVAR=gemini

# --- Privacidade ---
# padrao: Mentor e currículo só em provedores que não treinam com os dados (Groq, Ollama, pagos)
# estrita: também tradutor, histórias e feedback
# aberta: qualquer provedor configurado
AI_PRIVACIDADE=padrao
# Lista explícita de provedores aceitos para tarefas sensíveis (substitui a classificação padrão)
# AI_PROVEDORES_CONFIAVEIS=groq,ollama

# --- Limites ---
AI_TIMEOUT_MS=60000
# Máximo de provedores tentados por chamada
AI_MAX_TENTATIVAS=3
# Chamadas de IA por usuário por dia (acima disso, o motor de regras assume)
AI_LIMITE_DIARIO=150
# Chamadas complexas por usuário por dia (acima disso, a tarefa usa o nível intermediário)
AI_LIMITE_DIARIO_COMPLEXA=30
# Mensagens do Mentor por dia, por plano
AI_MENTOR_LIMITE_GRATIS=20
AI_MENTOR_LIMITE_PLUS=200

# Desliga totalmente a IA: AI_PROVIDER=none
# (Versão 1 continua aceita: AI_PROVIDER=anthropic|openai|openai-compatible + AI_MODEL / AI_MODEL_FAST)
