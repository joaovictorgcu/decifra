# ============================================================
# DECIFRA — variáveis de ambiente (copie para .env e ajuste)
# Nunca coloque credenciais reais neste arquivo.
# ============================================================

# --- Servidor ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3333
LOG_LEVEL=info
# Origem pública do frontend. Usada para validar a origem das requisições (CSRF).
# Em desenvolvimento é o Vite; em produção, a URL do app (ex.: https://decifra.app).
APP_ORIGIN=http://localhost:5173
SESSION_TTL_DAYS=30
# true quando o app roda atrás de HTTPS. Em produção o padrão já é true.
# COOKIE_SECURE=true
# Número de proxies reversos confiáveis na frente da API (Nginx, Render, Railway...). 0 = nenhum.
# Use o número exato: confiar na cadeia inteira de X-Forwarded-For permite burlar o rate limit.
TRUST_PROXY=0
# Em produção, a API serve o build do frontend a partir desta pasta.
# WEB_DIST=../web/dist

# --- Banco de dados ---
# SQLite local (caminho relativo a apps/api/prisma). Para PostgreSQL, veja docs/DATA_MODEL.md.
DATABASE_URL=file:./dev.db

# --- Inteligência Artificial ---
# none | anthropic | openai | openai-compatible
# Com "none", o DECIFRA funciona com o motor de regras (sem IA generativa).
AI_PROVIDER=none
# Modelo principal (Mentor, histórias, importação de currículo).
# Padrão para anthropic: claude-opus-5-5. Obrigatório para openai e openai-compatible.
# AI_MODEL=
# Modelo para tarefas rápidas (extração de requisitos, tradutor, feedback). Padrão: o mesmo de AI_MODEL.
# AI_MODEL_FAST=
# Sobrescrita por tarefa (opcional): AI_MODEL_EXTRAIR_REQUISITOS, AI_MODEL_TRADUZIR, AI_MODEL_HISTORIA,
# AI_MODEL_FEEDBACK, AI_MODEL_IMPORTAR_CV, AI_MODEL_MENTOR
AI_TIMEOUT_MS=60000

# Anthropic (Claude)
# ANTHROPIC_API_KEY=
# default = fallback automático do servidor quando o modelo recusa; off = desativado
ANTHROPIC_FALLBACKS=default

# OpenAI ou servidor compatível (Ollama, LM Studio, vLLM, OpenRouter)
# OPENAI_API_KEY=
# Ex.: Ollama local -> http://localhost:11434/v1
# OPENAI_BASE_URL=

# Limite diário de mensagens do Mentor por plano
AI_MENTOR_LIMITE_GRATIS=20
AI_MENTOR_LIMITE_PLUS=200
# Teto diário de chamadas de IA por usuário (todas as tarefas); acima dele, usa o motor de regras
AI_LIMITE_DIARIO=150
